 "lines": [
  {
   "id": "s1a",
   "scene": 1,
   "start": 0.5,
   "end": 2.569,
   "speech": [
    0.539,
    2.488
   ],
   "text": "Every broadcast has a crew.",
   "caption": null
  },
  {
   "id": "s1b",
   "scene": 1,
   "start": 2.869,
   "end": 4.96,
   "speech": [
    2.917,
    4.859
   ],
   "text": "So we built one, with AI.",
   "caption": null
  },
  {
   "id": "s2a",
   "scene": 2,
   "start": 6.5,
   "end": 10.575,
   "speech": [
    6.537,
    10.471
   ],
   "text": "PitchPulse streams a fully synthetic match through five stages.",
   "caption": "PitchPulse streams a fully synthetic match through five stages."
  },
  {
   "id": "s2b",
   "scene": 2,
   "start": 10.875,
   "end": 18.661,
   "speech": [
    10.914,
    18.577
   ],
   "text": "Ingest. A deterministic stats engine. An AI studio crew. Broadcast overlays. And a view for every viewer.",
   "caption": "Ingest. A deterministic stats engine. An AI studio crew. Broadcast overlays. And a view for every viewer."
  },
  {
   "id": "s3a",
   "scene": 3,
   "start": 20.5,
   "end": 23.615,
   "speech": [
    20.547,
    23.519
   ],
   "text": "The crew is five agents, each with one job.",
   "caption": "The crew is five agents, each with one job."
  },
  {
   "id": "s3b",
   "scene": 3,
   "start": 23.915,
   "end": 31.936,
   "speech": [
    23.95,
    31.841
   ],
   "text": "The Spotter finds the moment. The Analyst pulls the evidence. The Commentator writes it. The Producer decides what goes on air.",
   "caption": "The\u00a0Spotter finds the moment. The\u00a0Analyst pulls the evidence. The\u00a0Commentator writes it. The\u00a0Producer decides what goes on air."
  },
  {
   "id": "s3c",
   "scene": 3,
   "start": 32.436,
   "end": 36.66,
   "speech": [
    32.476,
    36.552
   ],
   "text": "And the Fact-checker blocks any number the stats engine can't prove.",
   "caption": "And the Fact-checker blocks any number the stats engine can't prove."
  },
  {
   "id": "s3d",
   "scene": 3,
   "start": 37.46,
   "end": 42.345,
   "speech": [
    37.487,
    42.263
   ],
   "text": "If a model fails, the crew falls back to templates, and says so on screen.",
   "caption": "If a model fails, the crew falls back to templates, and says so on screen."
  },
  {
   "id": "s4a",
   "scene": 4,
   "start": 45.0,
   "end": 51.933,
   "speech": [
    45.052,
    51.82
   ],
   "text": "Thirty-four minutes. Asante shoots from fifteen point four metres. A five per cent chance, and it's saved.",
   "caption": "34:16. Asante shoots from 15.4 m. A 5% chance, and it's saved."
  },
  {
   "id": "s4b",
   "scene": 4,
   "start": 53.133,
   "end": 55.864,
   "speech": [
    53.168,
    55.756
   ],
   "text": "But the engine saw Kerrigan, free in the middle.",
   "caption": "But the engine saw Kerrigan, free in the middle."
  },
  {
   "id": "s4c",
   "scene": 4,
   "start": 56.264,
   "end": 61.512,
   "speech": [
    56.296,
    61.437
   ],
   "text": "That pass arrives eighty-three per cent of the time, into a twenty-four per cent chance.",
   "caption": "That pass arrives 83% of the time, into a 24% chance."
  },
  {
   "id": "s4d",
   "scene": 4,
   "start": 62.112,
   "end": 64.757,
   "speech": [
    62.162,
    64.655
   ],
   "text": "Four times the value. He should have passed.",
   "caption": null
  },
  {
   "id": "s5a",
   "scene": 5,
   "start": 68.8,
   "end": 74.624,
   "speech": [
    68.84,
    74.538
   ],
   "text": "Same moment, two audiences. The analyst gets the evidence trail. The fan gets the story.",
   "caption": "Same moment, two audiences. The analyst gets the evidence trail. The fan gets the story."
  },
  {
   "id": "s6a",
   "scene": 6,
   "start": 78.5,
   "end": 80.825,
   "speech": [
    78.524,
    80.694
   ],
   "text": "In English, Spanish, or Arabic.",
   "caption": "In English, Spanish, or Arabic."
  },
  {
   "id": "s6b",
   "scene": 6,
   "start": 83.625,
   "end": 86.057,
   "speech": [
    83.66,
    85.998
   ],
   "text": "El pase val\u00eda cuatro veces m\u00e1s que el tiro.",
   "caption": "El pase val\u00eda 4 veces m\u00e1s que el tiro."
  },
  {
   "id": "s7a",
   "scene": 7,
   "start": 96.6,
   "end": 98.84,
   "speech": [
    96.624,
    98.741
   ],
   "text": "Drop it straight onto the broadcast.",
   "caption": null
  },
  {
   "id": "s7b",
   "scene": 7,
   "start": 100.24,
   "end": 104.208,
   "speech": [
    100.281,
    104.106
   ],
   "text": "And when VAR rules a goal out, the crew takes it back on air.",
   "caption": null
  },
  {
   "id": "s8a",
   "scene": 8,
   "start": 106.6,
   "end": 112.445,
   "speech": [
    106.644,
    112.349
   ],
   "text": "Built for Azure: Container Apps, Event Hubs and Azure OpenAI. Every number checked.",
   "caption": null
  },
  {
   "id": "s8b",
   "scene": 8,
   "start": 113.245,
   "end": 114.227,
   "speech": [
    113.286,
    114.135
   ],
   "text": "PitchPulse.",
   "caption": null
  }
 ],
