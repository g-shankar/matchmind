 "lines": [
  {
   "id": "s1a",
   "scene": 1,
   "start": 0.5,
   "end": 2.655,
   "speech": [
    0.528,
    2.572
   ],
   "text": "Every broadcast has a crew.",
   "caption": false
  },
  {
   "id": "s1b",
   "scene": 1,
   "start": 2.955,
   "end": 5.109,
   "speech": [
    2.986,
    5.023
   ],
   "text": "So we built one, with AI.",
   "caption": false
  },
  {
   "id": "s2a",
   "scene": 2,
   "start": 6.5,
   "end": 10.745,
   "speech": [
    6.529,
    10.655
   ],
   "text": "PitchPulse streams a fully synthetic match through five stages.",
   "caption": true
  },
  {
   "id": "s2b",
   "scene": 2,
   "start": 11.045,
   "end": 19.045,
   "speech": [
    11.072,
    18.952
   ],
   "text": "Ingest. A deterministic stats engine. An AI studio crew. Broadcast overlays. And a view for every viewer.",
   "caption": true
  },
  {
   "id": "s3a",
   "scene": 3,
   "start": 20.5,
   "end": 23.764,
   "speech": [
    20.54,
    23.662
   ],
   "text": "The crew is five agents, each with one job.",
   "caption": true
  },
  {
   "id": "s3b",
   "scene": 3,
   "start": 24.064,
   "end": 32.32,
   "speech": [
    24.117,
    32.236
   ],
   "text": "The Spotter finds the moment. The Analyst pulls the evidence. The Commentator writes it. The Producer decides what goes on air.",
   "caption": true
  },
  {
   "id": "s3c",
   "scene": 3,
   "start": 32.82,
   "end": 37.257,
   "speech": [
    32.858,
    37.139
   ],
   "text": "And the Fact-checker blocks any number the stats engine can't prove.",
   "caption": true
  },
  {
   "id": "s3d",
   "scene": 3,
   "start": 38.057,
   "end": 42.708,
   "speech": [
    38.101,
    42.604
   ],
   "text": "If a model fails, the crew falls back on screen, and the show goes on.",
   "caption": true
  },
  {
   "id": "s4a",
   "scene": 4,
   "start": 45.0,
   "end": 51.357,
   "speech": [
    45.064,
    51.266
   ],
   "text": "Thirty-four minutes. Asante shoots from fifteen metres. A five per cent chance, and it's saved.",
   "caption": true
  },
  {
   "id": "s4b",
   "scene": 4,
   "start": 52.557,
   "end": 55.437,
   "speech": [
    52.592,
    55.327
   ],
   "text": "But the engine saw Kerrigan, free in the middle.",
   "caption": true
  },
  {
   "id": "s4c",
   "scene": 4,
   "start": 55.837,
   "end": 61.256,
   "speech": [
    55.871,
    61.165
   ],
   "text": "That pass arrives eighty-three per cent of the time, into a twenty-four per cent chance.",
   "caption": true
  },
  {
   "id": "s4d",
   "scene": 4,
   "start": 61.856,
   "end": 64.651,
   "speech": [
    61.914,
    64.525
   ],
   "text": "Four times the value. He should have passed.",
   "caption": false
  },
  {
   "id": "s5a",
   "scene": 5,
   "start": 68.8,
   "end": 74.965,
   "speech": [
    68.839,
    74.863
   ],
   "text": "Same moment, two audiences. The analyst gets the evidence trail. The fan gets the story.",
   "caption": true
  },
  {
   "id": "s6a",
   "scene": 6,
   "start": 80.5,
   "end": 82.953,
   "speech": [
    80.536,
    82.82
   ],
   "text": "In English, Spanish, or Arabic.",
   "caption": true
  },
  {
   "id": "s6b",
   "scene": 6,
   "start": 83.553,
   "end": 85.58,
   "speech": [
    83.591,
    85.525
   ],
   "text": "El pase val\u00eda cuatro veces m\u00e1s.",
   "caption": true
  },
  {
   "id": "s7a",
   "scene": 7,
   "start": 90.6,
   "end": 94.696,
   "speech": [
    90.64,
    94.615
   ],
   "text": "Drop it straight onto the broadcast, or follow one player all match.",
   "caption": true
  },
  {
   "id": "s8a",
   "scene": 8,
   "start": 98.6,
   "end": 106.344,
   "speech": [
    98.624,
    106.258
   ],
   "text": "Built on Azure: Container Apps, Event Hubs, and Azure OpenAI with managed identity. Every number checked.",
   "caption": false
  },
  {
   "id": "s8b",
   "scene": 8,
   "start": 107.144,
   "end": 108.168,
   "speech": [
    107.187,
    108.063
   ],
   "text": "PitchPulse.",
   "caption": false
  }
 ],
