// Near-real-time ingestion: batch for at most 10 s instead of the 5 minute default.
.alter table MatchEvents policy ingestionbatching @'{"MaximumBatchingTimeSpan":"00:00:10","MaximumNumberOfItems":500,"MaximumRawDataSizeMB":256}'

.alter table MatchEventsEnriched policy ingestionbatching @'{"MaximumBatchingTimeSpan":"00:00:10","MaximumNumberOfItems":500,"MaximumRawDataSizeMB":256}'

// Synthetic demo data: keep it for a week.
.alter-merge table MatchEvents policy retention softdelete = 7d

.alter-merge table MatchEventsEnriched policy retention softdelete = 7d

// ---------------------------------------------------------------- 2. real-time queries
// All of them follow the newest match in the table.

// Live xG race: cumulative expected goals and score at the end of each match minute.
let matchId = toscalar(MatchEventsEnriched | top 1 by ts desc | project match_id);
MatchEventsEnriched
| where match_id == matchId
| summarize arg_max(seq, xg_home, xg_away, score_home, score_away) by minute
| project minute, xg_home, xg_away, score_home, score_away
| order by minute asc
| render linechart with (title = "Live xG race (home vs away)")

// Pressure by five-minute window: mean and peak of each club's pressure index (0-100).
let matchId = toscalar(MatchEventsEnriched | top 1 by ts desc | project match_id);
MatchEventsEnriched
| where match_id == matchId
| summarize avg_pressure_home = round(avg(pressure_home), 1), avg_pressure_away = round(avg(pressure_away), 1),
            peak_pressure_home = max(pressure_home), peak_pressure_away = max(pressure_away)
    by five_min_bucket
| order by five_min_bucket asc

// Sprint leaders: sprints (faster than 8 m/s, flagged by the stats engine) and top speed.
let matchId = toscalar(MatchEventsEnriched | top 1 by ts desc | project match_id);
MatchEventsEnriched
| where match_id == matchId and sprint == true
| summarize sprints = count(), top_speed_kmh = max(player_speed_kmh) by team_id, player_id
| top 10 by sprints desc, top_speed_kmh desc

// Better-option count: shots where a clearly better pass was on, and runs where the ball never came.
let matchId = toscalar(MatchEventsEnriched | top 1 by ts desc | project match_id);
MatchEventsEnriched
| where match_id == matchId
| summarize shots = countif(type == "shot"),
            better_option_shots = countif(has_better_option == true),
            unfound_runs = countif(has_unfound_run == true)
    by team_id

// Raw stream check (MatchEvents only): goals and event mix of the newest match.
let matchId = toscalar(MatchEvents | top 1 by ts desc | project match_id);
MatchEvents
| where match_id == matchId
| summarize events = count(), shots = countif(type == "shot"), goals = countif(type == "shot" and outcome == "goal")
    by team
| order by events desc
