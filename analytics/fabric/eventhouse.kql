// PitchPulse: Fabric Real-Time Intelligence (Eventhouse) / Azure Data Explorer
//
// STATUS: Not connected yet. This file has not been run against a live Eventhouse; no capacity,
// Eventstream or Event Hubs data connection exists for PitchPulse yet. See README.md in this
// folder for the owner-run steps.
//
// Two tables, two feeds:
//   MatchEvents          the raw Event Hubs `match-events` stream (the simulator's JSON, one event per
//                        message, schema 1.0 from backend/src/matchmind/schema/events.py). Live today
//                        on the producer side: `matchmind-sim live --sink eventhub`.
//   MatchEventsEnriched  the same events plus the stats engine's numbers (xG, pressure index, ...).
//                        The columns are the `events` table of the Lakehouse export. File shape:
//                        `matchmind-lakehouse enrich`. A live enriched stream (stats engine -> a second
//                        event hub) is planned, not built.
// Numbers come from the stats engine. The queries below only count, sum or take the latest value.
// `labels` (simulator ground truth for evaluation) is deliberately not ingested.
// Run each block on its own (the Eventhouse query editor splits blocks at blank lines).

// ---------------------------------------------------------------- 1. tables and mappings

.create-merge table MatchEvents (
    schema_version: string,
    event_id: string,
    match_id: string,
    seq: long,
    ts: datetime,
    period: long,
    clock_s: real,
    match_clock: string,
    type: string,
    team: string,
    player_id: string,
    receiver_id: string,
    possession_id: long,
    start_x: real,
    start_y: real,
    end_x: real,
    end_y: real,
    outcome: string,
    ball_speed_mps: real,
    player_speed_mps: real,
    under_pressure: bool,
    pressure_players: dynamic,
    body_part: string,
    freeze_frame: dynamic,
    tracking: dynamic,
    lineups: dynamic,
    details: dynamic
)

.create-or-alter table MatchEvents ingestion json mapping "MatchEventsMapping"
