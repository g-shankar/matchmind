# PitchPulse AI - Azure Cloud Environment Configuration
# Provide your Azure credentials below to connect to live Azure cloud services.
# If left empty, PitchPulse AI automatically operates in high-fidelity local emulation mode.

# 1. Azure OpenAI Service
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-azure-openai-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-06-01

# 2. Azure AI Translator Service
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/
AZURE_TRANSLATOR_REGION=eastus

# 3. Azure Event Hubs (Optional for high-throughput enterprise streaming)
AZURE_EVENTHUB_CONNECTION_STRING=
AZURE_EVENTHUB_NAME=match-events

# 4. Azure Cosmos DB (Optional for historical tactical vector search)
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
