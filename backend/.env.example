# Copy to .env (git ignores it) and fill in. Never commit real values.

# --- Azure Event Hubs (simulator live mode) ---------------------------------
# Preferred: Microsoft Entra ID auth, no secret needed. Run `az login` locally;
# in Azure the managed identity needs the "Azure Event Hubs Data Sender" role.
EVENTHUB_FULLY_QUALIFIED_NAMESPACE=your-namespace.servicebus.windows.net
EVENTHUB_NAME=match-events

# Fallback for quick local tests only. Leave blank if you use az login.
EVENTHUB_CONNECTION_STRING=

# --- AI studio crew -----------------------------------------------------------
# Paid service: stays false until the owner approves the spend. When false the
# crew runs in template mode (no network calls, no cost).
MATCHMIND_AI_ENABLED=false
# Azure OpenAI / Foundry model endpoint. Auth is Microsoft Entra ID via
# `az login` locally or managed identity in Azure: no API key needed.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure AI Translator (paid; optional, off unless set). Same Entra ID auth.
MATCHMIND_TRANSLATOR_ENABLED=false
AZURE_TRANSLATOR_ENDPOINT=https://your-translator.cognitiveservices.azure.com/
AZURE_TRANSLATOR_REGION=westeurope

# Web app origins allowed to call the API (comma separated).
MATCHMIND_ALLOWED_ORIGINS=http://localhost:3000
