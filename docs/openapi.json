{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SeekBody": {
        "additionalProperties": false,
        "properties": {
          "clock_s": {
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Clock S",
            "type": "number"
          },
          "period": {
            "anyOf": [
              {
                "enum": [
                  1,
                  2
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Period"
          }
        },
        "required": [
          "clock_s"
        ],
        "title": "SeekBody",
        "type": "object"
      },
      "SpeedBody": {
        "additionalProperties": false,
        "properties": {
          "speed_multiplier": {
            "enum": [
              1,
              10,
              60
            ],
            "title": "Speed Multiplier",
            "type": "integer"
          }
        },
        "required": [
          "speed_multiplier"
        ],
        "title": "SpeedBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
