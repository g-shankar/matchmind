    "/api/dataset/export": {
      "get": {
        "operationId": "dataset_export_api_dataset_export_get",
        "parameters": [
          {
            "in": "query",
            "name": "match_id",
            "required": true,
            "schema": {
              "maxLength": 32,
              "minLength": 3,
              "pattern": "^[A-Z0-9][A-Z0-9-]+$",
              "title": "Match Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "zip",
              "enum": [
                "jsonl",
                "csv",
                "zip"
              ],
              "title": "Format",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "tracking_period",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 2,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tracking Period"
            }
          },
          {
            "in": "query",
            "name": "tracking_from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 7200,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tracking From"
            }
          },
          {
            "in": "query",
            "name": "tracking_to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 7200,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tracking To"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Dataset Export"
      }
    },
